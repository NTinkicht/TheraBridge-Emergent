// TheraBridge API schema. TB-EM-001 checkpoint 0 retired the feasibility probe.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Non-domain placeholder (Prisma needs at least one model). Dropped once checkpoint A adds identity models.
model SchemaInfo {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(128)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("schema_info")
}
