// Each row is a new immutable proposal/revocation revision; never an authorization grant.
model ConsentRecordDraft {
  id String @id @default(uuid()) @db.Uuid
  centerId String @map("center_id") @db.Uuid
  childId String @map("child_id") @db.Uuid
  guardianLinkId String @map("guardian_link_id") @db.Uuid
  policyId String @map("policy_id") @db.Uuid
