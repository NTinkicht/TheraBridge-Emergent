// TB-EM-010 synthetic family practice outcomes. Separate from clinical observations; never progress evidence.
model PracticeOutcome {
  id               String           @id @default(uuid()) @db.Uuid
  centerId         String           @map("center_id") @db.Uuid
  childId          String           @map("child_id") @db.Uuid
  guardianLinkId   String           @map("guardian_link_id") @db.Uuid
  templateId       String           @map("template_id") @db.Uuid
  service          String           @db.VarChar(32)
  practiceDate     DateTime         @map("practice_date") @db.Date
  choice           String           @db.VarChar(16)
  idempotencyKey   String           @unique @map("idempotency_key") @db.Uuid
  synthetic        Boolean          @default(true)
  recordedById     String           @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime         @map("recorded_at") @db.Timestamptz(3)
  acknowledgedAt   DateTime?        @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?          @map("acknowledged_by_id") @db.Uuid
  guardianLink     GuardianLink     @relation(fields: [guardianLinkId], references: [id], onDelete: Restrict)
  template         ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([guardianLinkId, templateId, practiceDate])
  @@index([centerId, childId])
  @@map("practice_outcome")
}


// TB-EM-048: structured SYNTHETIC operational request, never a released care plan.
model HomePlanRequest {
  id            String    @id @default(uuid()) @db.Uuid
  centerId      String    @map("center_id") @db.Uuid
  childId       String    @map("child_id") @db.Uuid
  guardianLinkId String   @map("guardian_link_id") @db.Uuid
  requestKey    String    @unique @map("request_key") @db.Uuid
  service       String    @db.VarChar(32)
  status        String    @default("PENDING") @db.VarChar(32)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(3)
  respondedById String?   @map("responded_by_id") @db.Uuid
  center        Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  child         Child     @relation(fields: [childId], references: [id], onDelete: Restrict)
  guardianLink  GuardianLink @relation(fields: [guardianLinkId], references: [id], onDelete: Restrict)

  @@index([centerId, childId, service, status])
  @@index([guardianLinkId, createdAt])
  @@map("home_plan_request")
}

// TB-EM-009 progress reports. Drafts, immutable versions and future release records are separate tables.
model ProgressReport {
  id           String          @id @default(uuid()) @db.Uuid
  centerId     String          @map("center_id") @db.Uuid
  childId      String          @map("child_id") @db.Uuid
  membershipId String          @map("membership_id") @db.Uuid
  service      String          @db.VarChar(32)
  title        String          @db.VarChar(120)
  periodStart  DateTime        @map("period_start") @db.Date
  periodEnd    DateTime        @map("period_end") @db.Date
  status       String          @default("DRAFT") @db.VarChar(32)
  sections     Json            @default("{}")
  reviewNotes  Json            @default("[]") @map("review_notes")
  version      Int             @default(1)
  createdAt    DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @map("updated_at") @db.Timestamptz(3)
  versions     ReportVersion[]
  releases     ReportRelease[]
  suggestionDecisions ReportSuggestionDecision[]

  @@index([centerId, childId])
  @@map("progress_report")
}

model ReportVersion {
  id        String         @id @default(uuid()) @db.Uuid
  reportId  String         @map("report_id") @db.Uuid
  centerId  String         @map("center_id") @db.Uuid
  number    Int
  kind      String         @db.VarChar(16)
  sections  Json
  evidence  Json
  authorId  String         @map("author_id") @db.Uuid
  createdAt DateTime       @map("created_at") @db.Timestamptz(3)
  report    ProgressReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  releases  ReportRelease[]

  @@unique([reportId, number])
  @@map("report_version")
}

// Immutable, non-authorizing evidence-assist decisions. Clinical report text stays
// in ProgressReport.sections; only fingerprints and source/claim maps live here.
model ReportSuggestionDecision {
  id             String   @id @default(uuid()) @db.Uuid
  centerId       String   @map("center_id") @db.Uuid
  childId        String   @map("child_id") @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  service        String   @db.VarChar(32)
  membershipId   String   @map("membership_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  section        String   @db.VarChar(16)
  action         String   @db.VarChar(16)
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  reason         String?  @db.VarChar(500)
  requestHash    String   @map("request_hash") @db.Char(64)
  generator      String   @db.VarChar(32)
  sourceManifest Json     @map("source_manifest")
  sourceHash     String   @map("source_hash") @db.Char(64)
  claimMap       Json     @map("claim_map")
  passageHash    String?  @map("passage_hash") @db.Char(64)
  sectionHash    String   @map("section_hash") @db.Char(64)
  reportRevision Int      @map("report_revision")
  label          String   @default("NON_CLINICAL_DRAFT") @db.VarChar(32)
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  report         ProgressReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@unique([reportId, idempotencyKey])
  @@index([centerId, childId, reportId, createdAt])
  @@map("report_suggestion_decision")
}

// Never written: inserts are refused by a database trigger until report release is authorized.
model ReportRelease {
  id              String         @id @default(uuid()) @db.Uuid
  reportId        String         @map("report_id") @db.Uuid
  reportVersionId String         @map("report_version_id") @db.Uuid
  centerId        String         @map("center_id") @db.Uuid
  audience        String         @db.VarChar(32)
  releasedById    String         @map("released_by_id") @db.Uuid
  releasedAt      DateTime       @map("released_at") @db.Timestamptz(3)
  report          ProgressReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reportVersion   ReportVersion  @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)

  @@map("report_release")
}

// Internal snapshots are immutable and non-authorizing, independently of the mutable draft.
model GovernanceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  centerId String @map("center_id") @db.Uuid
  childId String @map("child_id") @db.Uuid
  kind String @db.VarChar(8)
  documentId String @map("document_id") @db.Uuid
  sourceVersion Int @map("source_version")
  content Json
  evidence Json
  fingerprint String @db.Char(64)
  authorId String @map("author_id") @db.Uuid
  generatedById String @map("generated_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([centerId, kind, documentId])
  @@map("governance_snapshot")
}
model GovernanceHistory {
  id String @id @default(uuid()) @db.Uuid
  centerId String @map("center_id") @db.Uuid
  childId String @map("child_id") @db.Uuid
  kind String @db.VarChar(8)
  documentId String @map("document_id") @db.Uuid
