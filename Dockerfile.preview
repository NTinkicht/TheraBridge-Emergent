# Synthetic preview only. Next.js + NestJS in ONE container and ONE public port.
# No real patient data, approval, signing, release or real audio/STT/AI.
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY package.json yarn.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
# Next's optional `sharp` (LGPL-3.0-or-later libvips) is only used by the
# next/image optimizer, which is disabled (images.unoptimized). Never ship it:
# remove it and the Yarn package cache in the SAME layer as the install, so no
# committed image layer ever contains the binaries; fail the build if any remain.
RUN yarn install --frozen-lockfile --network-timeout 600000 \
 && find /repo -type d \( -path '*/node_modules/sharp' -o -path '*/node_modules/@img' \) -prune -exec rm -rf {} + \
 && yarn cache clean \
 && ! find /repo "$(yarn cache dir)" -type d \( -path '*/node_modules/sharp' -o -path '*/node_modules/@img' \) -print 2>/dev/null | grep -q .
COPY apps/api apps/api
COPY apps/web apps/web
COPY scripts/preview/start.sh scripts/preview/start.sh
COPY scripts/preview/exec-runtime.sh scripts/preview/exec-runtime.sh
COPY scripts/preview/db-role-config.mjs scripts/preview/verify-runtime-db-role.mjs scripts/preview/
RUN chmod 0555 scripts/preview/start.sh
RUN yarn workspace @therabridge/api prisma generate && yarn workspace @therabridge/api build
ENV API_UPSTREAM_ORIGIN=http://127.0.0.1:8001
ENV NEXT_TELEMETRY_DISABLED=1
RUN yarn workspace @therabridge/web build
RUN mkdir -p /repo/.workspace/local-credentials /repo/apps/web/.next/cache && chown -R node:node /repo
USER node
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 CMD node -e "fetch('http://127.0.0.1:10000/api/health').then(r=>r.json()).then(h=>{if(h.database?.status!=='up')process.exit(1)}).catch(()=>process.exit(1))"
EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "scripts/preview/start.sh"]
