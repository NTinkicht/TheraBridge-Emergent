*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)
/.env
apps/api/.env
apps/web/.env.local
apps/**/.env*.local

# Emergent workspace-only runtime state (PostgreSQL data dir, logs, reference copies)
/.workspace/

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

